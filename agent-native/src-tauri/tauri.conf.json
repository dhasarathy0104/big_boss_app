{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BIG BOSS",
  "version": "0.16.0",
  "identifier": "com.desklog.agent",
  "build": {
    "frontendDist": "../setup-ui"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./nsis-hooks.nsh"
      }
    }
  }
}
